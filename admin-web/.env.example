# ==============================================================================
# SKAVIA ECOSYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local (never commit secrets to git)
# ==============================================================================

# Public Firebase Web SDK Config (Project: skavia-113a3)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=skavia-113a3.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=skavia-113a3
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id

# Surface Hostname Mapping (leave unset on single-domain *.vercel.app, or set custom subdomains)
NEXT_PUBLIC_PUBLIC_HOST=
NEXT_PUBLIC_SUPERADMIN_HOST=
NEXT_PUBLIC_ADMIN_HOST=

# Official Verified Mobile App Distribution Links (leave empty until uploaded/published)
NEXT_PUBLIC_ANDROID_APK_URL=
NEXT_PUBLIC_ANDROID_VERSION=
NEXT_PUBLIC_IOS_APP_STORE_URL=

# Server-Only Supabase Credentials (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Server-Only Admin Session Signing Key (32+ random hex bytes, e.g. openssl rand -hex 32)
ADMIN_SESSION_SECRET=replace_with_64_char_hex_secret

# Primary Super Admin Pinning (Firebase UID of the single primary Super Admin)
PRIMARY_SUPER_ADMIN_UID=

# Strict Security Policy Controls
ADMIN_ALLOWED_ORIGIN=https://admin.skavia.com
ADMIN_REQUIRE_MFA=true
ADMIN_INVITE_TTL_HOURS=24

# WebAuthn / FIDO2 Passkeys (optional overrides; automatically derived from request host in local/single-origin)
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Official Invitation & Alert Email Transport (Free SMTP via Nodemailer, or optional Resend API)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SKAVIA Security <security@skavia.com>"
RESEND_API_KEY=
