# ==============================================================================
# SKAVIA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and populate with your authorized credentials.
# NEVER commit the real '.env' file to source control.
# ==============================================================================

# Supabase PostgREST & Auth Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# SSLCommerz Payment Gateway (Defaults to official testbox sandbox)
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWD=qwerty
SSLCOMMERZ_IS_SANDBOX=true

# SKAVIA AI Intelligence Layer (Groq & OpenRouter)
# Required only if compiling with local client-side LLM inference
# Production applications should route inference through Supabase Edge Functions
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
HUGGINGFACE_TOKEN=your_huggingface_token_here
